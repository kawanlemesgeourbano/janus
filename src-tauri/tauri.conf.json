{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Janus",
  "version": "1.0.3-alpha.1",
  "identifier": "local.agi.janus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Janus",
        "width": 460,
        "height": 740,
        "minWidth": 380,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
